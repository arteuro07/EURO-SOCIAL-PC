{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boss-de-rien.local/schema/storyboard.schema.json",
  "title": "BOSS DE RIEN storyboard",
  "type": "object",
  "required": ["episode_id", "title", "format", "fps", "duration_seconds", "shots"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^E[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "format": {"const": "vertical-9:16"},
    "fps": {"type": "integer", "enum": [24, 30]},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "shot_size", "camera_angle", "description", "camera", "layers"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "shot_size": {"enum": ["extreme-wide", "wide", "medium", "close-up", "extreme-close-up", "insert"]},
          "camera_angle": {"enum": ["eye-level", "low", "high", "dutch", "over-shoulder", "top-down"]},
          "description": {"type": "string"},
          "dialogue": {"type": "array", "items": {"type": "object", "required": ["character", "text"], "properties": {"character": {"type": "string"}, "text": {"type": "string"}, "delivery": {"type": "string"}}}},
          "camera": {"type": "object", "required": ["move"], "properties": {"move": {"enum": ["static", "push-in", "pull-out", "pan-left", "pan-right", "tilt-up", "tilt-down", "shake", "parallax"]}, "intensity": {"type": "number", "minimum": 0, "maximum": 1}}},
          "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "role"], "properties": {"name": {"type": "string"}, "role": {"enum": ["background", "character", "prop", "foreground", "ink", "color", "shadow", "light", "effect", "lettering"]}, "asset": {"type": "string"}}}},
          "effects": {"type": "array", "items": {"type": "string"}},
          "sound": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
